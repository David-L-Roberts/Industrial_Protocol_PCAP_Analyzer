# ============================================================================
# Industrial Protocol PCAP Analyzer — Default Test & Local Dev Configuration
# Copy to `.env` to override for custom/remote hosts or local paths.
# ============================================================================

# --- TimescaleDB / PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=protocol_analyzer
POSTGRES_USER=analyzer
POSTGRES_PASSWORD=analyzer_dev_password
# Optional explicit Npgsql connection string override (if omitted, built from POSTGRES_* above):
# TIMESCALE_CONNECTION_STRING=Host=localhost;Port=5432;Database=protocol_analyzer;Username=analyzer;Password=analyzer_dev_password

# --- MinIO / S3 Object Storage ---
MINIO_PORT=9000
MINIO_ENDPOINT=localhost:9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_password
MINIO_BUCKET=pcap-captures
MINIO_USE_SSL=false

# --- Grafana ---
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin_dev_password

# --- TShark Dissector ---
# Can be an executable name on PATH (e.g. tshark) or a full file path (e.g. C:\Program Files\Wireshark\tshark.exe):
TSHARK_PATH=C:\Program Files\Wireshark\tshark.exe

# --- Integration Test Options ---
# Set to true to keep test session rows in TimescaleDB and uploaded objects in MinIO after test runs:
KEEP_TEST_DATA=false
